----- JavaSc -----

make human function to convert button into a choice variable, "rock", "paper", or "scissors"
for (let child of div.children) {
        child.addEventListener('click', () => {
        let option = child.textContent;

        switch(option) {
                case 'rock':
                choice = 'rock'
                break;
                case 'paper':
                choice = 'paper'
                break;
                case 'scissors':
                choice = 'scissors'
                break;
        }

        hChoice.innerText = "Human's choice: " + choice
        cMove.innerText = "Computer's choice: " + computer
        });
}
        

make computer function to select random integer between 1 and 3
function computerRandom() {
        let computerRandom = Math.floor(Math.random() * 3 + 1);
        if (computerRandom === 1) { 
                cChoice = 'rock'
        } else if (computerRandom === 2) {
                cChoice = 'paper'  
        } else if (computerRandom === 3) {
                cChoice = 'scissors'
        }
        computer = cChoice
}       

