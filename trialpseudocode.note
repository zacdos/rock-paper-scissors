make announcement variable

when the button is clicked, a compareFunction will compare humanChoice and computerChoice
function compareChoice(choice, computer) {
        if (choice === computer) {
                ann.innerHTML = "It's a tie!"
                return;
        } else if (choice === 'rock' && computer === 'scissors') {
                hScore.innerHTML ++
                ann.innerHTML = "Human wins the round!"
                winner();
        } else if (choice === 'scissors' && computer === 'paper') {
                hScore.innerHTML ++
                ann.innerHTML = "Human wins the round!"
                winner();
        } else if (choice === 'paper' && computer === 'rock') {
                hScore.innerHTML ++ 
                ann.innerHTML = "Human wins the round!"
                winner();
        } else { 
                cScore.innerHTML ++
                ann.innerHTML = "Computer wins the round!"
                winner();
        }
}

